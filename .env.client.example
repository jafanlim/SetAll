# .env.client.example  →  copy to .env.client, fill real values, keep gitignored (only this .example is committed)
# This is the ONLY env file passed to the Flutter build:
#   flutter run --dart-define-from-file=.env.client
#   flutter build <platform> --dart-define-from-file=.env.client
# Everything here is PUBLISHABLE / client-safe (shipped inside the app binary). NO server secrets.
#
# NOTE on naming (see spec OPEN-4): Supabase reserves the SUPABASE_ prefix and auto-injects it into
# Edge Functions, so the publishable key is stored under SUPABASE_ANON_KEY (its slot), not *_PUBLISHABLE.
# The value is the sb_publishable_… key — the variable name is legacy, the value is the new key.

# ─── SUPABASE (client) ────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here   # publishable key (RLS-enforced, safe in client)

# ─── GOOGLE OAUTH CLIENT IDs (public identifiers) ─────────────────────────────
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# ─── FIREBASE CLIENT API KEYS (public, restricted by app/domain rules) ────────
FIREBASE_WEB_API_KEY=AIzaSy-your-web-key
FIREBASE_ANDROID_API_KEY=AIzaSy-your-android-key
FIREBASE_IOS_API_KEY=AIzaSy-your-ios-key
