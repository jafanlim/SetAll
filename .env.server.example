# .env.server.example  →  copy to .env.server, fill real values, keep gitignored (only this .example is committed)
# Consumed by SERVER surfaces ONLY. NEVER pass this to the Flutter build / --dart-define.
#   Supabase Edge Functions:  source .env.server && supabase secrets set KEY="$KEY" --project-ref <ref>
#   Netlify Functions:        Netlify dashboard → Environment Variables (or `netlify env:set`)
#
# RESERVED-PREFIX WARNING: you CANNOT `supabase secrets set` any SUPABASE_*-prefixed name —
# Supabase auto-injects SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY into every
# function at runtime. So the secret key below is only needed LOCALLY (for `supabase functions serve`
# and to populate the trigger migration); in prod the function reads the auto-injected value.

# ─── SUPABASE (server) ────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here   # secret key — BYPASSES RLS. Server only. Never ship.

# ─── INTERNAL FUNCTION AUTH ───────────────────────────────────────────────────
# Shared secret checked by the 9 internal Edge Functions (x-edge-secret header).
# Also stored in Supabase Vault as `edge_shared_secret` (read by the trigger/cron migration).
# Generate: openssl rand -hex 32
EDGE_SHARED_SECRET=your_64_char_hex_secret_here

# ─── THIRD-PARTY ──────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_key                 # also set in Netlify env (web ai-analyst + voice-entry)
GEMINI_API_KEY=your_gemini_key                 # ONLY if mobile ai-analyst still uses Gemini — confirm (spec OPEN-7)
RESEND_API_KEY=re_your_resend_key
WELCOME_HOOK_SECRET=your_welcome_hook_secret   # also set in Supabase Auth Hook header config
# Paste the entire service-account JSON as a SINGLE line (multi-line breaks the dotenv/CLI parser):
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
