#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Env / secrets (if you switch to .env for Supabase URL/key)
.env
.env.*
!.env.example
!.env.client.example
!.env.server.example

# Firebase config files — contain API keys, never commit these
# Keep local copies but do NOT push to public repos.
# Share via secure channel (1Password, team vault, CI/CD secrets).
google-services.json
GoogleService-Info.plist
lib/firebase_options.dart

# Firebase CLI cache
.firebase/

# Xcode / test artifacts (large)
xcresult_*.json
*.xcresult
flutter_*.log
build_log_*.txt

# Local Netlify folder
.netlify

# Node modules (Tailwind CLI)
node_modules/
package-lock.json

# Generated Tailwind CSS (rebuild with: make tailwind)
web/styles.css

# ── Local Co-Dev Artifacts (never commit) ────────────────────────────────────
# Living documentation files — managed outside version control
projectledger.md
wiki doc.md

# Local environment config — use .env.example as the committed template
.env
.env.local
.env.*.local

# Promptfoo eval output (generated)
promptfoo/*_results.json
promptfoo/.cache/
